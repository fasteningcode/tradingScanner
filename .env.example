# Flask Application Environment Variables
# Copy this file to .env and update with your own values

# Secret key for session management and CSRF protection
# Generate a secure key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-change-this-before-running

# Database configuration
# For development: sqlite:///app.db
# For production: postgresql://user:password@localhost/dbname
DATABASE_URL=sqlite:///app.db

# Emergency Database Restore Password
# This password allows database restoration in emergency situations
# Set this to a strong, unique password and keep it secure
# Access emergency restore at: /settings/emergency-restore
EMERGENCY_RESTORE_PASSWORD=change-this-to-a-strong-password

# Flask configuration
FLASK_APP=run.py
FLASK_ENV=development
